# ─── Certificates & keys (generated by cb-certs.sh, never commit) ─────────────
ca/
certs/
*.pem
*.key
*.crt
*.cer
*.csr
*.srl
*.p12
*.pfx
*.jks
# EC2 key pairs / SSH keys
id_rsa*
id_ed25519*
*.ppk

# ─── Credentials & local configuration ────────────────────────────────────────
.env
.env.*
*.local
secrets/

# ─── Generated / pulled cluster artefacts ─────────────────────────────────────
# migrate-sgw-config.py output (bootstrap.json, db-config-*.json, users-*.json
# with passwords) — default --output-dir is ./migrated
migrated/
bootstrap.json
db-config-*.json
users-*.json
# Legacy SGW configs copied off a node (contain server credentials)
sync_gateway*.json
# migrate-indexes.sh metadata dumps, if copied out of /tmp
index-metadata-*.json
index-restore-*.json
# Couchbase backups, cbcollect_info bundles, logs
backup*/
*.zip
*.tar
*.tar.gz
*.tgz
*.log
logs/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ─── Terraform / infra state ──────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# ─── Editors & OS ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
